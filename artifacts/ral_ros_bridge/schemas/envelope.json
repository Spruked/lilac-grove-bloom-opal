{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RAL_Envelope",
  "type": "object",
  "required": ["event_id", "robot_id", "cycle_id", "schema", "payload"],
  "properties": {
    "event_id": { "type": "string" },
    "robot_id": { "type": "string" },
    "task_id": { "type": "string" },
    "cycle_id": { "type": "integer" },
    "schema": { "type": "string" },
    "priority": { "type": "string", "enum": ["estop", "high", "normal", "background"] },
    "robot_time": {
      "type": "object",
      "required": ["sec", "nsec"],
      "properties": {
        "sec": { "type": "integer" },
        "nsec": { "type": "integer" }
      }
    },
    "world_etag": { "type": ["string", "integer", "null"] },
    "payload": { "type": "object" }
  }
}
